# ===== 代理商价目表生成器（云端版）环境变量示例 =====
# 复制本文件为 .env（或在云平台的「环境变量」里逐项填写）

# 监听端口（云平台通常会自动注入 PORT，本地默认 3000）
PORT=3000

# 登录令牌签名密钥：生产环境务必改成一长串随机字符（泄露会导致他人伪造登录）
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-me-to-a-long-random-string

# 是否允许任何人自助注册：true=开放注册 / false=仅管理员开户（内部员工用）
# 注意：无论该项如何，第一个注册的账号都会自动成为管理员
ALLOW_REGISTRATION=true

# SQLite 数据库文件路径。
# 本地默认 ./data/app.db。
# Render/Railway 等平台：请创建「持久化磁盘(Persistent Disk)」并把这里指向挂载目录，
# 例如 /var/data/app.db，否则每次部署数据会被清空！
DB_PATH=./data/app.db

# 请求体上限（价目表含 base64 图片时会偏大）
MAX_BODY=25mb
